# 引擎、编译器和运行镜像固定摘要，运行期不安装依赖。
FROM golang:1.26.11-alpine@sha256:ae52b5bc6ed045a9ed26ab03dc19327a802a9cc9aa8b27ed57f5c6b60579b0bb AS engine
WORKDIR /engine
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
COPY engines/trojan/go.mod engines/trojan/go.sum ./
RUN go mod download
COPY engines/trojan ./
RUN go test ./... && go build -trimpath -ldflags="-s -w" -o /out/trojan-engine .
FROM golang:1.26.11-alpine@sha256:ae52b5bc6ed045a9ed26ab03dc19327a802a9cc9aa8b27ed57f5c6b60579b0bb AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN go build -trimpath -ldflags="-s -w" -o /out/vpnrunner ./cmd/vpnrunner

FROM alpine:3.22@sha256:365499d9dccb7c8cfaffef995a6c382e71174585e0556f6476ead1c5971c39fb
RUN addgroup -g 10001 proxy && adduser -D -H -u 10002 -G proxy vpn
COPY --from=engine /out/trojan-engine /usr/local/bin/trojan-engine
COPY --from=build /out/vpnrunner /usr/local/bin/vpnrunner
COPY deploy/default.proxy.json /etc/trojan-proxy/proxy.json
COPY engines/trojan /usr/share/trojan-engine-source
USER 10002:10001
ENTRYPOINT ["vpnrunner"]
